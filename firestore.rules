rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // HELPERS
    // ============================================================

    function signedIn() {
      return request.auth != null;
    }

    function myUid() {
      return request.auth.uid;
    }

    function myEmail() {
      return request.auth.token.email != null ? request.auth.token.email.lower() : "";
    }

    function spaceDoc(spaceId) {
      return get(
        /databases/$(database)/documents/spaces/$(spaceId)
      );
    }

    function isSpaceMember(spaceId) {
      return signedIn()
        && exists(
          /databases/$(database)/documents/spaces/$(spaceId)
        )
        && myUid() in spaceDoc(spaceId).data.memberUids;
    }


    // ============================================================
    // GLOBAL PROGRESS
    // ============================================================

    match /{path=**}/progress/{uid} {
      allow read: if signedIn()
        && (
          myUid() == uid
          || resource.data.uid == myUid()
        );
    }


    // ============================================================
    // USERS
    // ============================================================

    match /users/{uid} {

      // User can manage their own profile.
      allow read, write: if signedIn()
        && myUid() == uid;

      // Members of the same Space can read each other's profiles.
      allow read: if signedIn()
        && exists(
          /databases/$(database)/documents/users/$(myUid())
        )
        && resource.data.spaceId != null
        && resource.data.spaceId
          == get(
            /databases/$(database)/documents/users/$(myUid())
          ).data.spaceId;


      // ----------------------------------------------------------
      // PRIVATE PERIOD TRACKER
      // ----------------------------------------------------------

      match /periodTracker/{docId} {
        allow read, write: if signedIn()
          && myUid() == uid;
      }


      // ----------------------------------------------------------
      // PRIVATE PERIOD CYCLES
      // ----------------------------------------------------------

      match /periodCycles/{cycleId} {
        allow read, write: if signedIn()
          && myUid() == uid;
      }


      // ----------------------------------------------------------
      // PRIVATE MOODS
      // ----------------------------------------------------------

      match /moods/{date} {
        allow read, write: if signedIn()
          && myUid() == uid;
      }


      // ----------------------------------------------------------
      // PRIVATE WORKOUTS
      // ----------------------------------------------------------

      match /workouts/{workoutId} {
        allow read, write: if signedIn()
          && myUid() == uid;
      }


      // ----------------------------------------------------------
      // PRIVATE DIARY
      // ----------------------------------------------------------

      match /diaryEntries/{dateId} {
        allow read, write: if signedIn()
          && myUid() == uid;
      }
    }


    // ============================================================
    // SPACES
    // ============================================================

    match /spaces/{spaceId} {

      // ----------------------------------------------------------
      // READ SPACE
      // ----------------------------------------------------------

      allow read: if isSpaceMember(spaceId);


      // ----------------------------------------------------------
      // CREATE SPACE
      // ----------------------------------------------------------

      allow create: if signedIn()
        && request.resource.data.createdBy == myUid()
        && request.resource.data.memberUids.size() == 1
        && request.resource.data.memberUids.hasAll([myUid()]);


      // ----------------------------------------------------------
      // UPDATE SPACE
      //
      // Existing member:
      //     Can update their Space normally.
      //
      // Invited user:
      //     Can add themselves only when accepting a valid invite.
      // ----------------------------------------------------------

      allow update: if
        isSpaceMember(spaceId)

        ||

        (
          signedIn()

          // User is not already a member.
          && !(myUid() in resource.data.memberUids)

          // User is being added.
          && myUid() in request.resource.data.memberUids

          // Exactly one new member.
          && request.resource.data.memberUids.size()
            == resource.data.memberUids.size() + 1

          // Maximum two members.
          && request.resource.data.memberUids.size() <= 2

          // Existing members cannot be removed.
          && request.resource.data.memberUids
            .hasAll(resource.data.memberUids)

          // New member profile must exist.
          && request.resource.data.members[myUid()] != null

          // Invite ID must be attached to the Space update.
          && 'lastInviteId' in request.resource.data

          // Invite must exist.
          && exists(
            /databases/$(database)/documents/invites/
            $(request.resource.data.lastInviteId)
          )

          // Invite belongs to this Space.
          && get(
            /databases/$(database)/documents/invites/
            $(request.resource.data.lastInviteId)
          ).data.spaceId == spaceId

          // Invite was sent to this user's email.
          && get(
            /databases/$(database)/documents/invites/
            $(request.resource.data.lastInviteId)
          ).data.invitedEmail == myEmail()

          // Invite is still pending.
          && get(
            /databases/$(database)/documents/invites/
            $(request.resource.data.lastInviteId)
          ).data.status == "pending"
        );


      // Spaces cannot be deleted.
      allow delete: if false;


      // ==========================================================
      // MEMBERS
      // ==========================================================

      match /members/{uid} {

        allow read: if isSpaceMember(spaceId);

        allow write: if isSpaceMember(spaceId);
      }


      // ==========================================================
      // TASKS
      // ==========================================================

      match /tasks/{taskId} {

        allow read: if isSpaceMember(spaceId);

        allow create: if isSpaceMember(spaceId)
          && request.resource.data.ownerUid == myUid();

        allow update, delete: if isSpaceMember(spaceId)
          && resource.data.ownerUid == myUid();
      }


      // ==========================================================
      // ROUTINES
      // ==========================================================

      match /routines/{routineId} {

        allow read: if isSpaceMember(spaceId);

        allow create: if isSpaceMember(spaceId)
          && request.resource.data.ownerUid == myUid();

        allow update, delete: if isSpaceMember(spaceId)
          && resource.data.ownerUid == myUid();
      }


      // ==========================================================
      // HABITS
      // ==========================================================

      match /habits/{habitId} {

        allow read: if isSpaceMember(spaceId);

        allow create: if isSpaceMember(spaceId)
          && request.resource.data.ownerUid == myUid();

        allow update, delete: if isSpaceMember(spaceId)
          && resource.data.ownerUid == myUid();
      }


      // ==========================================================
      // GOALS
      // ==========================================================

      match /goals/{goalId} {

        allow read: if isSpaceMember(spaceId);

        allow create: if isSpaceMember(spaceId)
          && request.resource.data.createdByUid == myUid();

        allow update: if isSpaceMember(spaceId);

        allow delete: if isSpaceMember(spaceId)
          && resource.data.createdByUid == myUid();
      }


      // ==========================================================
      // DAILY PROGRESS
      // ==========================================================

      match /days/{date}/progress/{uid} {

        allow read: if isSpaceMember(spaceId);

        allow create, update: if isSpaceMember(spaceId)
          && myUid() == uid;

        allow delete: if false;
      }


      // ==========================================================
      // DAILY CONNECTIONS
      // ==========================================================

      match /dailyConnections/{date}/entries/{uid} {

        allow read: if isSpaceMember(spaceId);

        allow create, update: if isSpaceMember(spaceId)
          && myUid() == uid;

        allow delete: if isSpaceMember(spaceId)
          && myUid() == uid;
      }


      // ==========================================================
      // SHARED MOODS
      // ==========================================================

      match /sharedMoods/{date}/entries/{uid} {

        allow read: if isSpaceMember(spaceId);

        allow create, update: if isSpaceMember(spaceId)
          && myUid() == uid;

        allow delete: if isSpaceMember(spaceId)
          && myUid() == uid;
      }


      // ==========================================================
      // MEMORIES
      // ==========================================================

      match /memories/{memoryId} {

        allow read: if isSpaceMember(spaceId);

        allow create: if isSpaceMember(spaceId)
          && request.resource.data.authorUid == myUid();

        allow update: if isSpaceMember(spaceId)
          && (
            resource.data.authorUid == myUid()
            ||
            request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly(['reactions'])
          );

        allow delete: if isSpaceMember(spaceId);
      }


      // ==========================================================
      // NOTES
      // ==========================================================

      match /notes/{noteId} {

        allow read: if isSpaceMember(spaceId);

        allow create: if isSpaceMember(spaceId)
          && request.resource.data.authorUid == myUid();

        allow update, delete: if isSpaceMember(spaceId);
      }


      // ==========================================================
      // PINGS
      // ==========================================================

      match /pings/{pingId} {

        allow read: if isSpaceMember(spaceId);

        allow create: if isSpaceMember(spaceId)
          && request.resource.data.uid == myUid();

        allow delete: if false;
      }


      // ==========================================================
      // DAILY QUESTIONS
      // ==========================================================

      match /dailyQuestions/{date} {

        allow read: if isSpaceMember(spaceId);

        allow create, update: if isSpaceMember(spaceId);

        allow delete: if false;
      }


      // ==========================================================
      // SUPPORT REQUESTS
      // ==========================================================

      match /supportRequests/{requestId} {

        allow read: if isSpaceMember(spaceId);

        allow create: if isSpaceMember(spaceId)
          && request.resource.data.uid == myUid();

        allow update: if isSpaceMember(spaceId);

        allow delete: if false;
      }
    }


    // ============================================================
    // INVITES
    // ============================================================

    match /invites/{inviteId} {

      // ----------------------------------------------------------
      // READ INVITE
      //
      // Inviter can see their own invite.
      // Invitee can see an invite sent to their email.
      // ----------------------------------------------------------

      allow read: if signedIn()
        && (
          resource.data.invitedByUid == myUid()
          ||
          (
            request.auth.token.email != null
            && resource.data.invitedEmail
              == request.auth.token.email.lower()
          )
        );


      // ----------------------------------------------------------
      // CREATE INVITE
      //
      // Only an existing Space member can create an invite.
      // Space must currently have only one member.
      // ----------------------------------------------------------

      allow create: if signedIn()
        && request.resource.data.invitedByUid == myUid()
        && request.resource.data.status == "pending"
        && request.resource.data.invitedEmail != null
        && request.resource.data.invitedEmail != myEmail()
        && request.resource.data.spaceId != null
        && isSpaceMember(request.resource.data.spaceId)
        && spaceDoc(
          request.resource.data.spaceId
        ).data.memberUids.size() == 1;


      // ----------------------------------------------------------
      // UPDATE INVITE
      //
      // Invitee:
      //     pending -> accepted
      //
      // Inviter:
      //     Can change status/cancelledAt only.
      // ----------------------------------------------------------

      allow update: if signedIn()
        && (
          (
            request.auth.token.email != null
            && resource.data.invitedEmail
              == request.auth.token.email.lower()
            && resource.data.status == "pending"
            && request.resource.data.status == "accepted"
            && request.resource.data.acceptedByUid == myUid()
          )

          ||

          (
            resource.data.invitedByUid == myUid()
            && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly([
                "status",
                "cancelledAt"
              ])
          )
        );


      // ----------------------------------------------------------
      // DELETE INVITE
      // ----------------------------------------------------------

      allow delete: if signedIn()
        && resource.data.invitedByUid == myUid();
    }


    // ============================================================
    // LEGACY DATA
    // ============================================================

    match /coupleData/{docId} {

      allow read: if signedIn();

      allow write: if false;
    }
  }
}